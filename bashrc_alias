K_RZ_SRC_PATH=~/rz_linux-cip
K_RZ_BUILD_PATH=~/rz_linux-cip-build
K_BBB_SRC_PATH=~/linux-bbb
K_BBB_BUILD_PATH=~/linux-bbb-build
K_ML_SRC_PATH=~/linux
K_ML_BUILD_PATH=~/linux-build
K_NFS_PATH=/nfs

# Copy the modules from <build>/modroot into every rootfs under $K_NFS_PATH
# Usage: kcopy_modules <build path>
kcopy_modules() {
    KREL=$(cat "$1/include/config/kernel.release")

    for ROOTFS in "$K_NFS_PATH"/*/; do
        # Skip folders that are not a rootfs (e.g. /nfs/adb)
        [ -d "$ROOTFS/lib" ] || continue

        sudo mkdir -p "$ROOTFS/lib/modules"
        sudo rsync -a --delete --chown=root:root \
            "$1/modroot/lib/modules/$KREL/" \
            "$ROOTFS/lib/modules/$KREL/"

        echo "Installed modules $KREL into $ROOTFS"
    done
}

kbuild_rz() {
    cd "$K_RZ_SRC_PATH" || return 1
    . /opt/rz-bsp-plus/5.0.11/environment-setup-cortexa55-poky-linux || return 1
    make O="$K_RZ_BUILD_PATH" defconfig || return 1
    make O="$K_RZ_BUILD_PATH" -j$(nproc) || return 1

    # Install modules into a temporary folder: ~/rz_linux-cip-build/modroot
    rm -rf "$K_RZ_BUILD_PATH/modroot"
    make O="$K_RZ_BUILD_PATH" \
        INSTALL_MOD_PATH="$K_RZ_BUILD_PATH/modroot" \
        INSTALL_MOD_STRIP=1 \
        modules_install || return 1
}

kbuild_bbb() {
    cd "$K_BBB_SRC_PATH" || return 1
    make O="$K_BBB_BUILD_PATH" ARCH=arm CROSS_COMPILE=arm-linux-gnueabihf- omap2plus_defconfig || return 1
    make O="$K_BBB_BUILD_PATH" ARCH=arm CROSS_COMPILE=arm-linux-gnueabihf- -j$(nproc) || return 1
}

kbuild_ml() {
    cd "$K_ML_SRC_PATH" || return 1
    . /opt/rz-bsp-plus/5.0.11/environment-setup-cortexa55-poky-linux || return 1
    make O="$K_ML_BUILD_PATH" defconfig || return 1
    make O="$K_ML_BUILD_PATH" -j$(nproc) || return 1

    # Install modules into a temporary folder: ~/linux-build/modroot
    rm -rf "$K_ML_BUILD_PATH/modroot"
    make O="$K_ML_BUILD_PATH" \
        INSTALL_MOD_PATH="$K_ML_BUILD_PATH/modroot" \
        INSTALL_MOD_STRIP=1 \
        modules_install || return 1
}

kcopy_ml() {
    # 1. Copy Image and device trees to TFTP
    sudo rm -rf /srv/tftp/*
    sudo cp \
        "$K_ML_BUILD_PATH/arch/arm64/boot/Image" \
        "$K_ML_BUILD_PATH/arch/arm64/boot/dts/renesas/r9a07g044l2-smarc.dtb" \
        "$K_ML_BUILD_PATH/arch/arm64/boot/dts/renesas/r9a09g056n48-rzv2n-evk.dtb" \
        "$K_ML_BUILD_PATH/arch/arm64/boot/dts/renesas/r9a09g047e57-smarc.dtb" \
        "$K_ML_BUILD_PATH/arch/arm64/boot/dts/renesas/r9a08g045s33-smarc.dtb" \
        "$K_ML_BUILD_PATH/arch/arm64/boot/dts/renesas/r9a08g045s33-smarc-pmod1-type-3a.dtb" \
        /srv/tftp/

    # 2. Copy the modules into all NFS rootfs
    kcopy_modules "$K_ML_BUILD_PATH"
}

kcopy_rz() {
    # 1. Copy Image and device trees to TFTP
    sudo rm -rf /srv/tftp/*
    sudo cp \
        "$K_RZ_BUILD_PATH/arch/arm64/boot/Image" \
        "$K_RZ_BUILD_PATH/arch/arm64/boot/dts/renesas/r9a07g044l2-smarc.dtb" \
        "$K_RZ_BUILD_PATH/arch/arm64/boot/dts/renesas/r9a09g056n48-rzv2n-evk.dtb" \
        "$K_RZ_BUILD_PATH/arch/arm64/boot/dts/renesas/r9a09g047e57-smarc.dtb" \
        "$K_RZ_BUILD_PATH/arch/arm64/boot/dts/renesas/r9a08g045s33-smarc.dtb" \
        "$K_RZ_BUILD_PATH/arch/arm64/boot/dts/mybrd/mybrd.dtb" \
        "$K_RZ_BUILD_PATH/arch/arm64/boot/dts/renesas/r9a08g045s33-smarc-pmod1-type-3a.dtb" \
        /srv/tftp/

    # 2. Copy the modules into all NFS rootfs
    kcopy_modules "$K_RZ_BUILD_PATH"
}
